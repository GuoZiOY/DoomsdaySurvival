<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>建筑验证</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- 直接链接 Assets 下的源文件：验证用的就是游戏里跑的那份代码，不复制副本（避免漂移） -->
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Assets\Scripts\Data\数据模型.cs" />
    <Compile Include="..\..\Assets\Scripts\Data\数据解析.cs" />
    <Compile Include="..\..\Assets\Scripts\Domain\网格\确定性随机.cs" />
    <Compile Include="..\..\Assets\Scripts\Domain\网格\网格数据.cs" />
    <Compile Include="..\..\Assets\Scripts\Domain\网格\门口保护.cs" />   <!-- 刀32：门口四邻的唯一实现（生成期与验证期共用） -->
    <Compile Include="..\..\Assets\Scripts\Domain\网格\网格视野.cs" />
    <Compile Include="..\..\Assets\Scripts\Domain\网格\视野规则.cs" />
    <Compile Include="..\..\Assets\Scripts\Domain\网格\约束摆放.cs" />
    <Compile Include="..\..\Assets\Scripts\Domain\房间\房间生成器.cs" />
    <Compile Include="..\..\Assets\Scripts\Domain\建筑\建筑生成器.cs" />
    <!-- 建筑外形（配方 → 占地掩码）：数据标识核对要查"形状名认不认识 / 掩码连不连通" -->
    <Compile Include="..\..\Assets\Scripts\Data\建筑外形.cs" />
  </ItemGroup>
</Project>
